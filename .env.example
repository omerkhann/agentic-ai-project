# Copy to .env and fill in. Never commit .env.
# LLM provider for the zero-shot LLM-judge baseline: ollama | gemini | groq | openrouter
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Google AI Studio free tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct:free
# Optional: higher HF Hub rate limits
HF_TOKEN=
